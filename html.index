<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Abdul Wajid - Ustad Nama</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Arial}
body{background:#f4f7f0;color:#1a2e1a;line-height:2.1}
header{background:#0F3D2E;color:white;padding:28px 15px;text-align:center;border-radius:0 0 25px 25px}
.card{background:white;padding:18px;margin:14px; border-radius:18px;box-shadow:0 4px 12px #0001;border-right:6px solid #0F3D2E;cursor:pointer}
.card h3{font-size:18px;color:#0F3D2E}
.detail{display:none;margin-top:12px;border-top:1px dashed #bbb;padding-top:12px;color:#333;text-align:justify}
.card.open .detail{display:block}
.badge{background:#0F3D2E;color:white;padding:3px 10px;border-radius:10px;font-size:12px;margin-left:8px}
.b{color:#0F3D2E;font-weight:bold}
</style>
</head>
<body>
<header>
<h1>📚 استاد نامہ</h1>
<p>از: Abdul Wajid - Online Academy 03142028572</p>
</header>

<div id="list"></div>

<script>
const data=[
{
t:"1. نیت کی اصلاح",
d:`<span class=b>تفصیل:</span> ہر عمل کا دارومدار نیت پر ہے۔ کلاس سے پہلے دل میں سوچیں "میں اللہ کی رضا کے لیے پڑھا رہا ہوں"۔ اگر نیت صرف تنخواہ کی ہوگی تو برکت نہیں ہوگی۔<br><br><span class=b>عملی طریقہ:</span> روز 10 سیکنڈ آنکھ بند کر کے نیت دہرائیں۔`
},
{
t:"2. وضو کا اہتمام",
d:`<span class=b>تفصیل:</span> قرآن کو چھونا عبادت ہے۔ اللہ فرماتا ہے: <b>لَّا يَمَسُّهُ إِلَّا الْمُطَهَّرُونَ</b> (الواقعہ 79)۔ استاد خود باوضو آئے گا تو بچے بھی سیکھیں گے۔<br><br><span class=b>عملی طریقہ:</span> جو بچہ باوضو آئے اسے "ستارہِ طہارت" دیں۔`
},
{
t:"3. قرآن کو اونچی جگہ رکھنا",
d:`<span class=b>تفصیل:</span> یہ قرآن کی تعظیم کا حصہ ہے۔ قرآن کو کبھی زمین پر، بیگ میں جوتوں یا لنچ کے ساتھ نہ رکھیں۔ اس پر کوئی اور کتاب نہ رکھیں۔<br><br><span class=b>عملی طریقہ:</span> کلاس میں ایک اونچی میز/رحل مخصوص کریں۔`
},
{
t:"4. تلاوت کے وقت خاموشی",
d:`<span class=b>تفصیل:</span> اللہ کا حکم ہے: <b>وَإِذَا قُرِئَ الْقُرْآنُ فَاسْتَمِعُوا لَهُ وَأَنْصِتُوا</b> (الاعراف 204) جب قرآن پڑھا جائے تو غور سے سنو اور خاموش رہو۔<br><br><span class=b>عملی طریقہ:</span> تلاوت سے پہلے استاد خود موبائل سائلنٹ کرے اور انگلی سے خاموشی کا اشارہ کرے۔`
},
{
t:"5. سبق کی تیاری",
d:`<span class=b>تفصیل:</span> بغیر تیاری کے پڑھانا وقت ضائع کرنا ہے۔ کامیاب پیریڈ کے 3 حصے رکھیں: 0-5 منٹ دعا و دہرائی، 5-25 منٹ نیا سبق، 25-40 منٹ مشق و خلاصہ۔<br><br><span class=b>عملی طریقہ:</span> رات کو 10 منٹ اگلے دن کا سبق دیکھ لیں۔`
},
{
t:"6. کلاس کنٹرول - پہلے پیار",
d:`<span class=b>تفصیل:</span> نبی ﷺ نے کبھی بچے کو نہیں مارا۔ پہلے نام لے کر پیار سے سمجھائیں، پھر آنکھ سے اشارہ، پھر پاس بلا کر سمجھائیں۔<br><br><span class=b>عملی طریقہ:</span> مارنے کی بجائے ذمہ داری دیں، جیسے "آج آپ مانیٹر ہیں"۔`
},
{
t:"7. شفقت: عمل کو برا کہیں، بچے کو نہیں",
d:`<span class=b>تفصیل:</span> یہ بہت اہم اصول ہے۔ "تم جھوٹے ہو" نہ کہیں، بلکہ کہیں "جھوٹ بولنا برا عمل ہے"۔ بچے کی عزت نفس مجروح نہ کریں۔<br><br><span class=b>عملی طریقہ:</span> غلطی پر اکیلے میں سمجھائیں، سب کے سامنے تعریف کریں۔`
},
{
t:"8. سوال کا طریقہ: ہر بچہ روز بولے",
d:`<span class=b>تفصیل:</span> کلاس میں صرف ذہین بچوں سے نہیں، ہر بچے سے سوال کریں تاکہ سب کی حاضری ذہنی بھی ہو۔<br><br><span class=b>عملی طریقہ:</span> روز حاضری کے بعد 3 کمزور بچوں سے لازمی آسان سوال پوچھیں۔`
},
{
t:"9. دہرائی: پہلے 5 منٹ پچھلا سبق",
d:`<span class=b>تفصیل:</span> نیا سبق شروع کرنے سے پہلے پچھلے سبق کی دہرائی ضروری ہے، ورنہ بچہ بھول جائے گا۔ یہ سنت طریقہ ہے۔<br><br><span class=b>عملی طریقہ:</span> پہلے 5 منٹ میں 2 بچوں سے پچھلا سبق سنیں۔`
},
{
t:"10. نظم و ضبط: استاد وقت کا پابند ہو",
d:`<span class=b>تفصیل:</span> بچے استاد کے عمل سے سیکھتے ہیں۔ اگر استاد خود لیٹ آئے گا تو بچے وقت کی قدر نہیں کریں گے۔<br><br><span class=b>عملی طریقہ:</span> کلاس سے 5 منٹ پہلے آئیں، وقت پر چھٹی دیں۔`
},
{
t:"11. والدین سے رابطہ: ہفتہ وار رپورٹ",
d:`<span class=b>تفصیل:</span> استاد، بچہ، والدین تینوں مل کر تربیت کرتے ہیں۔ والدین کو صرف شکایت نہ کریں، اچھی بات بھی بتائیں۔<br><br><span class=b>عملی طریقہ:</span> ہفتے میں ایک بار واٹس ایپ پر لکھیں "آج آپ کے بیٹے نے بہت اچھا پڑھا"۔`
},
{
t:"12. اپنا اخلاق: کردار ہی نصاب ہے",
d:`<span class=b>تفصیل:</span> بچے کتاب سے زیادہ استاد کا کردار دیکھتے ہیں۔ آپ کا سچ، مسکراہٹ، صبر ہی اصل سبق ہے۔<br><br><span class=b>عملی طریقہ:</span> ہمیشہ مسکرا کر ملیں، سلام میں پہل کریں۔`
},
{
t:"13. کمزور بچے: الگ 5 منٹ توجہ",
d:`<span class=b>تفصیل:</span> ذہین بچہ سب توجہ دیتے ہیں، اصل استاد وہ ہے جو کمزور کو ساتھ لے کر چلے۔<br><br><span class=b>عملی طریقہ:</span> چھٹی کے بعد روز ایک کمزور بچے کو 5 منٹ روک کر پیار سے پڑھائیں۔`
},
{
t:"14. انعام: روز ایک ستارہ",
d:`<span class=b>تفصیل:</span> نبی ﷺ بچوں کی حوصلہ افزائی فرماتے تھے۔ انعام سے بچے میں شوق پیدا ہوتا ہے۔<br><br><span class=b>عملی طریقہ:</span> روز ایک چھوٹا ستارہ، ٹافی یا "شاباش" کا کارڈ ضرور دیں۔`
},
{
t:"15. دعا سے آغاز و اختتام",
d:`<span class=b>تفصیل:</span> علم اللہ کی طرف سے ہے۔ کلاس دعا سے شروع اور دعا پر ختم کریں۔<br><br><span class=b>عملی طریقہ:</span> شروع میں "رب زدنی علما" اور آخر میں سب مل کر ایک چھوٹی دعا کریں۔`
}
];

let h="";
data.forEach((x,i)=>{
h+=`<div class="card" onclick="this.classList.toggle('open')"><h3><span class="badge">${i+1}</span> ${x.t}</h3><div class="detail">${x.d}</div></div>`;
});
document.getElementById("list").innerHTML=h;
</script>
</body>
</html>
