<style>
*{box-sizing:border-box;margin:0;padding:0;font-family: 'Noto Nastaliq Urdu', Arial}
body{background:#eef2e8;color:#1a2e1a;line-height:2}
header{background:#0F3D2E;color:white;padding:30px 20px;text-align:center;border-radius:0 0 30px 30px}
