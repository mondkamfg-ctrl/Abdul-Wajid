.tabs button.active{background:white;color:#0F3D2E;font-weight:bold}
.section{padding:18px;max-width:700px;margin:auto}
.hidden{display:none!important}
.card{background:white;padding:18px;margin:14px 0;border-radius:18px;box-shadow:0 4px 15px #0001;border-right:6px solid #0F3D2E;cursor:pointer}
.card .detail{display:none;margin-top:10px;border-top:1px dashed #ccc;padding-top:10px;color:#444}
.card.open .detail{display:block}
.badge{background:#0F3D2E;color:white;padding:2px 10px;border-radius:10px;font-size:12px;margin-left:8px}
input, textarea{width:100%;padding:14px;border-radius:12px;border:1px solid #ccc;margin:10px 0;font-size:16px}
.btn{background:#0F3D2E;color:white;border:none;padding:12px;border-radius:12px;width:100%;font-size:18px;cursor:pointer}
.contact-box{background:#fff;padding:20px;border-radius:18px;margin-top:20px;border:2px solid #0F3D2E}
